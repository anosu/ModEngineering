<Project>
    <PropertyGroup>
        <BaseOutputPath Condition="'$(SharedDependencyBuildRoot)' == ''">$(ModRepositoryRoot)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <Deterministic>true</Deterministic>
        <BepInExVersion Condition="'$(BepInExVersion)' == ''">6.0.0-be.788</BepInExVersion>
        <BepInExPluginInfoVersion Condition="'$(BepInExPluginInfoVersion)' == ''">2.1.0</BepInExPluginInfoVersion>
    </PropertyGroup>
</Project>

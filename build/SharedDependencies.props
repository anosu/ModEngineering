<Project>
    <PropertyGroup>
        <_UseLocalSharedDependencies Condition="'$(CI)' != 'true' and '$(GITHUB_ACTIONS)' != 'true' and '$(UsePinnedSharedDependencies)' != 'true' and ('$(UsePinnedSharedDependencies)' == 'false' or $([System.String]::Copy('$(SolutionName)').EndsWith('.local')))">true</_UseLocalSharedDependencies>
    </PropertyGroup>
    <Import Project="$(ModRepositoryRoot)SharedDependencies.local.props"
        Condition="'$(_UseLocalSharedDependencies)' == 'true' and Exists('$(ModRepositoryRoot)SharedDependencies.local.props')" />
    <PropertyGroup>
        <UtilityProjectPath Condition="'$(UtilityProjectPath)' == ''">$(ModRepositoryRoot)shared/Utility/src/Utility/Utility.csproj</UtilityProjectPath>
        <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
        <SharedDependencyMode Condition="'$(SharedDependencyMode)' == ''">pinned</SharedDependencyMode>
        <SharedDependencyBuildRoot Condition="'$(SharedDependencyBuildRoot)' == ''">$(ModRepositoryRoot)artifacts/shared/$(SharedDependencyMode)/</SharedDependencyBuildRoot>
        <SharedReferenceBuildProperties Condition="'$(BuildingInsideVisualStudio)' != 'true'">SharedDependencyBuildRoot=$(SharedDependencyBuildRoot)</SharedReferenceBuildProperties>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(UtilityProjectPath)" Private="true" AdditionalProperties="$(SharedReferenceBuildProperties)" GlobalPropertiesToRemove="OutputPath;BaseOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
        <ProjectReference Include="$(ExtensionProjectPath)" Condition="'$(ExtensionProjectPath)' != ''" Private="true" AdditionalProperties="$(SharedReferenceBuildProperties)" GlobalPropertiesToRemove="OutputPath;BaseOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    </ItemGroup>
    <Target Name="ValidateSharedProjects" BeforeTargets="ResolveProjectReferences">
        <Error Condition="'$(_UseLocalSharedDependencies)' == 'true' and !Exists('$(ModRepositoryRoot)SharedDependencies.local.props')" Text="Local dependency configuration is missing: SharedDependencies.local.props." />
        <Error Condition="!Exists('$(UtilityProjectPath)')" Text="Utility source is missing. Initialize shared/Utility, or configure SharedDependencies.local.props and explicitly enable local dependencies." />
        <Error Condition="'$(ExtensionProjectPath)' != '' and !Exists('$(ExtensionProjectPath)')" Text="Optional dependency source is missing. Initialize its configured submodule, or configure SharedDependencies.local.props and explicitly enable local dependencies." />
    </Target>
</Project>
